# Copier en .env (jamais commit). Les variables commentees serviront aux etapes suivantes.

# --- Base de donnees ---
DATABASE_URL="postgresql://pedalpilot:pedalpilot@localhost:5433/pedalpilot?schema=public"

# --- Redis (BullMQ, etape relance) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me-with-a-long-random-string"
DASHBOARD_API_TOKEN= # générer une valeur aléatoire longue; accès au dashboard et aux événements

# --- LLM pour le chat ---
# Groq (recommandé pour démarrer; API compatible OpenAI)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=650
LLM_TEMPERATURE=0.3
# Optionnel: low, medium ou high (modèles compatibles avec le raisonnement)
# LLM_REASONING_EFFORT=low
# OpenRouter: LLM_PROVIDER=openrouter, LLM_BASE_URL=https://openrouter.ai/api/v1,
#             LLM_MODEL= fournisseur/modele et votre clé dans LLM_API_KEY
# Ollama local: LLM_PROVIDER=ollama, LLM_BASE_URL=http://localhost:11434/v1,
#               LLM_MODEL=nom-du-modele-local; pas de clé requise
# --- STT pour la voix (transcription audio) ---
# STT_PROVIDER=openai-compat
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=fr

# --- Google Calendar sandbox (etape 5) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# GOOGLE_CALENDAR_ID="primary"

# --- E-mail (etape 5) ---
# RESEND_API_KEY=""
# MAIL_FROM="PedalPilot <onboarding@resend.dev>"

# --- Telegram + n8n (etape 6) ---
# TELEGRAM_BOT_TOKEN=""
# N8N_WEBHOOK_URL=""
# N8N_WEBHOOK_SECRET=""
