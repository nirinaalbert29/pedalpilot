# Copier en .env (jamais commit). Les variables commentees serviront aux etapes suivantes.

# --- Base de donnees ---
DATABASE_URL="postgresql://pedalpilot:pedalpilot@localhost:5433/pedalpilot?schema=public"

# --- Redis (BullMQ, etape relance) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me-with-a-long-random-string"

# --- IA (etape 3) ---
# ANTHROPIC_API_KEY=""
# LLM_MODEL=""

# --- Google Calendar sandbox (etape 5) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# GOOGLE_CALENDAR_ID="primary"

# --- E-mail (etape 5) ---
